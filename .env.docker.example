# Copia a .env.docker en la raíz del proyecto:
#   cp .env.docker.example .env.docker
#
# O deja que scripts/docker-demo-up.sh genere puertos libres automáticamente.

# Dominio público de la app
ARTEMIS_DOMAIN=artemis.init.com.mx
# URL canónica (ajusta el puerto si ARTEMIS_HTTP_PORT no es 80)
ARTEMIS_PUBLIC_URL=http://artemis.init.com.mx

# --- Demo productivo (docker-compose.demo.yml) ---
# Puerto HTTP publicado en el host (Caddy). Si está ocupado, el script elige otro.
ARTEMIS_HTTP_PORT=18080
# Puerto directo al backend (solo debug; déjalo vacío para no publicar)
ARTEMIS_APP_PORT=

# --- Desarrollo (docker-compose.yml) ---
ARTEMIS_DEV_BACKEND_PORT=18000
ARTEMIS_DEV_FRONTEND_PORT=13000
ARTEMIS_DEV_DB_PORT=15432
ARTEMIS_DEV_REDIS_PORT=16379
ARTEMIS_DEV_MAILHOG_SMTP_PORT=11025
ARTEMIS_DEV_MAILHOG_UI_PORT=18025

# Django demo (también pueden ir en backend/.env)
SECRET_KEY=demo-secret-cambiar-en-produccion-real
DEMO_USER_EMAIL=demo@artemis.local
DEMO_USER_PASSWORD=demo123
DEMO_ADMIN_EMAIL=admin@artemis.local
DEMO_ADMIN_PASSWORD=admin123
