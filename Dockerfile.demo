# syntax=docker/dockerfile:1

# --- Frontend build (Webpack producción) ---
FROM node:22-alpine AS frontend-build

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN echo "shamefully-hoist=true" > .npmrc \
    && corepack enable && corepack prepare pnpm@10 --activate \
    && pnpm install --frozen-lockfile=false

COPY webpack.config.js tsconfig.json postcss.config.mjs ./
COPY frontend ./frontend

RUN NODE_ENV=production pnpm exec webpack --progress --bail --mode=production


# --- Backend demo ---
FROM python:3.12-slim AS demo

ENV PYTHONFAULTHANDLER=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PIP_DEFAULT_TIMEOUT=100 \
    POETRY_VERSION=2.0.1 \
    DJANGO_SETTINGS_MODULE=artemis.settings.demo

RUN groupadd user && useradd --create-home --home-dir /home/user -g user user \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3-dev gcc build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install "poetry==$POETRY_VERSION"

WORKDIR /home/user/app

COPY pyproject.toml /home/user/app/
COPY *poetry.lock /home/user/app/
RUN poetry config virtualenvs.create false \
    && poetry install --without dev --no-root --no-interaction --no-ansi

COPY backend ./backend
COPY --from=frontend-build /app/frontend/webpack_bundles ./frontend/webpack_bundles
COPY --from=frontend-build /app/webpack-stats.json ./webpack-stats.json
COPY frontend/assets ./frontend/assets

RUN chmod +x /home/user/app/backend/scripts/docker-entrypoint-demo.sh \
    && mkdir -p /home/user/app/backend/staticfiles /home/user/app/backend/mediafiles \
    && chown -R user:user /home/user/app

USER user
WORKDIR /home/user/app/backend

EXPOSE 8000

ENTRYPOINT ["/home/user/app/backend/scripts/docker-entrypoint-demo.sh"]
