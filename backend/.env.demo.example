# Copiar a backend/.env.demo si necesitas personalizar (opcional).
# docker-compose.demo.yml ya define estas variables.

DJANGO_SETTINGS_MODULE=artemis.settings.demo
DATABASE_URL=postgres://artemis:artemis_demo@db:5432/artemis
SECRET_KEY=demo-secret-cambiar-en-produccion-real
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
HOST=http://localhost:8080

# Cuenta demo (app) — creada automáticamente al arrancar
DEMO_USER_EMAIL=demo@artemis.local
DEMO_USER_PASSWORD=demo123

# Admin Django (/admin/)
DEMO_ADMIN_EMAIL=admin@artemis.local
DEMO_ADMIN_PASSWORD=admin123

# Forzar re-seed de datos en cada arranque (normalmente false)
DEMO_SEED_FORCE=false
